# Copy this file to .env and fill in your own values. Neither file is
# committed (.env is gitignored) - .env.example just documents what's needed.

# Optional - only needed if you have approved Reddit API access (ingest.py,
# scheduler.py's 'reddit' source). Reddit's app registration moved to a
# manual-approval process - no longer the instant self-serve flow this used
# to be. The default live source (hn_ingest.py, Hacker News) needs none of
# this.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SentimentAutomated/0.1

# Optional - only needed for the news-headlines source (news.py).
# Get a free key at https://newsapi.org/register
NEWSAPI_KEY=
